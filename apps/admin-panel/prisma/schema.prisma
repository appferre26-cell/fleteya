// Base de datos de FleteYa.
// Propietarios y motoristas son tablas separadas: una cuenta de un tipo nunca sirve para entrar al otro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Propietario {
  id           String    @id @default(cuid())
  nombre       String
  correo       String    @unique
  passwordHash String
  activo       Boolean   @default(true)
  ultimoAcceso DateTime?
  creadoEn     DateTime  @default(now())
  creadoPorId  String?

  motoristasCreados  Motorista[]          @relation("CreadoPor")
  motoristasAprobados Motorista[]         @relation("AprobadoPor")
  historial          HistorialMotorista[]
  recargasRegistradas Recarga[]           @relation("RecargasRegistradas")
  recargasAnuladas    Recarga[]           @relation("RecargasAnuladas")
  clientesBloqueados  ClienteBloqueado[]  @relation("ClientesBloqueados")
  gastos              Gasto[]             @relation("GastosRegistrados")
}

enum EstadoMotorista {
  PENDIENTE  // registrado, falta revisar documentos
  ACTIVO     // aprobado, puede recibir viajes
  SUSPENDIDO // no puede recibir viajes
}

enum TipoVehiculo {
  PICKUP
  CAMION_LIVIANO
  CAMION_MEDIANO_GRANDE
}

model Motorista {
  id                   String          @id @default(cuid())
  nombre               String
  telefono             String          @unique // 8 dígitos; es su usuario en la app del motorista
  correo               String?
  passwordHash         String
  debeCambiarPassword  Boolean         @default(true)

  // Documentos: DUI, licencia y tarjeta de circulación (frente y reverso) + 4 fotos del vehículo
  dui                  String          @unique // formato 00000000-0
  licenciaNumero       String
  licenciaVence        DateTime        @db.Date

  // Vehículo (sale de la tarjeta de circulación)
  placa                String          @unique
  marca                String
  modelo               String
  tipoVehiculo         TipoVehiculo
  capacidadTon         Decimal         @db.Decimal(4, 1)

  estado               EstadoMotorista @default(PENDIENTE)
  motivoSuspension     String?
  aprobadoEn           DateTime?
  aprobadoPorId        String?
  aprobadoPor          Propietario?    @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  creadoPorId          String?         // vacío = se registró él mismo desde la app
  creadoPor            Propietario?    @relation("CreadoPor", fields: [creadoPorId], references: [id])
  autoRegistro         Boolean         @default(false)
  creadoEn             DateTime        @default(now())
  actualizadoEn        DateTime        @updatedAt

  documentos           Documento[]
  historial            HistorialMotorista[]

  // Parte 3: app del motorista
  disponible           Boolean         @default(false) // botón "Disponible" en su app
  lat                  Float?
  lng                  Float?
  ubicacionEn          DateTime?
  vistoEn              DateTime?       // última vez que la app habló con el servidor
  ultimoAcceso         DateTime?
  terminosVersion      String?
  terminosAceptadosEn  DateTime?
  saldoCreditos        Decimal         @default(0) @db.Decimal(8, 2) // puede quedar en negativo
  viajes               Viaje[]
  ofertas              OfertaPrecio[]
  rechazos             RechazoViaje[]
  movimientos          MovimientoCredito[]
  recargas             Recarga[]
  avisos               SuscripcionAviso[]

  // Parte 10: acceso a la plataforma (pago único) y datos para la factura
  accesoPagadoEn       DateTime?       // sin esto no se puede aprobar
  accesoReferencia     String?         // referencia de transferencia que avisó el motorista desde su app
  accesoAvisadoEn      DateTime?
  requiereCreditoFiscal Boolean        @default(false)
  nit                  String?
  nrc                  String?
  razonSocial          String?
  giro                 String?
  direccionFiscal      String?
}

enum TipoDocumento {
  DUI_FRENTE
  DUI_REVERSO
  LICENCIA_FRENTE
  LICENCIA_REVERSO
  TARJETA_FRENTE
  TARJETA_REVERSO
  VEHICULO_FRENTE
  VEHICULO_ATRAS
  VEHICULO_IZQUIERDA
  VEHICULO_DERECHA
  FOTO_PERFIL // opcional: la ve el cliente para saber quién le atenderá (no entra en los documentos obligatorios)
}

model Documento {
  id           String        @id @default(cuid())
  motoristaId  String
  motorista    Motorista     @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  tipo         TipoDocumento
  mime         String
  datos        Bytes
  subidoEn     DateTime      @default(now())

  @@unique([motoristaId, tipo])
}

model HistorialMotorista {
  id            String      @id @default(cuid())
  motoristaId   String
  motorista     Motorista   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  propietarioId String?     // vacío = lo hizo el motorista desde su app
  propietario   Propietario? @relation(fields: [propietarioId], references: [id])
  accion        String      // CREADO, AUTOREGISTRO, PAGO_ACCESO, AVISO_PAGO, APROBADO, SUSPENDIDO, REACTIVADO, EDITADO, CONTRASENA_RESTABLECIDA, DOCUMENTO_ACTUALIZADO
  detalle       String?
  fecha         DateTime    @default(now())

  @@index([motoristaId, fecha])
}


// ───────────── Parte 2: link del cliente ─────────────

// Lo que el cliente elige en "¿Qué vas a llevar?". Los pesos se ajustan desde el panel.
model Material {
  id       String      @id @default(cuid())
  nombre   String      @unique
  unidad   String      // Bolsa, Unidad, Metro cúbico...
  pesoKg   Decimal     @db.Decimal(10, 2) // peso aproximado de UNA unidad
  activo   Boolean     @default(true)     // desactivado = oculto para el cliente, sin borrarlo
  orden    Int         @default(0)
  creadoEn DateTime    @default(now())
  items    ViajeItem[]
}

// Ferretería con QR: el link lleva ?f=CODIGO y la recogida sale ya llenada.
model PuntoQR {
  id        String   @id @default(cuid())
  codigo    String   @unique // FER001, FER002...
  nombre    String
  direccion String
  lat       Float
  lng       Float
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  viajes    Viaje[]
}

// Una sola fila (id = 1): tarifas y zona de servicio, editables sin tocar código.
model Configuracion {
  id             Int      @id @default(1)
  precioTonelada Decimal  @default(10) @db.Decimal(8, 2)
  tarifaMinima   Decimal  @default(10) @db.Decimal(8, 2)
  kmIncluidos    Decimal  @default(5) @db.Decimal(5, 1)
  recargoKmPct   Decimal  @default(10) @db.Decimal(5, 2) // % del precio base que se cobra por cada km que pase de los km incluidos
  zonaNombre     String   @default("Lourdes, Colón")
  zonaLat        Float    @default(13.725)
  zonaLng        Float    @default(-89.37)
  zonaRadioKm    Decimal  @default(8) @db.Decimal(5, 1)
  whatsappAyuda  String?  // 8 dígitos; vacío = no se muestra el botón "Ayuda"
  comisionPct    Decimal  @default(13.5) @db.Decimal(5, 2) // % de cada viaje que se descuenta de los créditos
  // Parte 10: ya no hay planes; el motorista recarga el monto que quiera y paga una sola vez el acceso
  precioAcceso   Decimal  @default(10) @db.Decimal(8, 2)
  // Parte 4: datos que salen en los recibos y la cuenta donde el motorista paga
  emisorNombre    String? // socio inscrito en Hacienda
  emisorNit       String?
  emisorDireccion String?
  bancoNombre     String?
  bancoTipoCuenta String? @default("Ahorro")
  bancoNumero     String?
  bancoTitular    String?
  // Parte 5: el motorista puede proponer otro precio también dentro de los km incluidos
  contraofertaEnRango Boolean @default(true)
  // Parte 8: área de servicio dibujada en el mapa ([{lat,lng},...], mínimo 3 puntos). Vacía = se usa el círculo.
  zonaPoligono   Json?
  actualizadoEn  DateTime @updatedAt
}

enum EstadoViaje {
  BUSCANDO  // esperando que un motorista acepte
  ASIGNADO  // un motorista aceptó (Parte 3)
  EN_CAMINO
  CARGANDO
  EN_RUTA
  ENTREGADO
  CANCELADO
}

model Viaje {
  id                String      @id @default(cuid())
  numero            Int         @unique @default(autoincrement()) // se muestra como FY-0001
  codigo            String      @unique // clave secreta del link del cliente (/viaje/codigo)
  clienteNombre     String
  clienteTelefono   String
  origenDireccion   String
  origenLat         Float
  origenLng         Float
  destinoDireccion  String
  destinoLat        Float
  destinoLng        Float
  distanciaKm       Decimal     @db.Decimal(6, 2) // en línea recta ("a la redonda")
  pesoKg            Decimal     @db.Decimal(10, 2)
  precioBase        Decimal     @db.Decimal(8, 2) // por peso, con mínimo
  fueraDeRango      Boolean     // más km que los incluidos: el motorista puede ofrecer otro precio
  rangoTon          String?     // Parte 5: el cliente eligió por toneladas ("0-1", "1-2", "2-3", "3+") en vez de materiales
  nota              String?
  estado            EstadoViaje @default(BUSCANDO)
  canceladoPor      String?     // CLIENTE, PROPIETARIO
  motivoCancelacion String?
  canceladoEn       DateTime?
  puntoQrId         String?
  puntoQr           PuntoQR?    @relation(fields: [puntoQrId], references: [id])
  aceptoTerminosEn  DateTime
  creadoEn          DateTime    @default(now())
  items             ViajeItem[]

  // Parte 3: motorista
  motoristaId       String?
  motorista         Motorista?  @relation(fields: [motoristaId], references: [id])
  precioFinal       Decimal?    @db.Decimal(8, 2) // precio acordado (base u oferta aceptada)
  comision          Decimal?    @db.Decimal(8, 2) // lo que se descontó de créditos al entregar
  asignadoEn        DateTime?
  enCaminoEn        DateTime?
  cargandoEn        DateTime?
  enRutaEn          DateTime?
  entregadoEn       DateTime?
  ofertas           OfertaPrecio[]
  rechazos          RechazoViaje[]
  avisos            SuscripcionAviso[]

  // Parte 6: calificaciones (1 a 5 estrellas). *CalificadoEn sin estrellas = lo omitió.
  estrellasMotorista    Int?      // la pone el cliente
  comentarioMotorista   String?
  motoristaCalificadoEn DateTime?
  estrellasCliente      Int?      // la pone el motorista
  comentarioCliente     String?
  clienteCalificadoEn   DateTime?

  @@index([estado, creadoEn])
  @@index([motoristaId, estado])
  @@index([clienteTelefono])
}

model ViajeItem {
  id          String    @id @default(cuid())
  viajeId     String
  viaje       Viaje     @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  materialId  String?   // vacío = "Otro" escrito por el cliente
  material    Material? @relation(fields: [materialId], references: [id])
  nombre      String    // copia del nombre al momento del pedido
  unidad      String
  cantidad    Decimal   @db.Decimal(10, 2)
  pesoUnitKg  Decimal   @db.Decimal(10, 2)
  pesoTotalKg Decimal   @db.Decimal(10, 2)
}


// ───────────── Parte 3: app del motorista ─────────────

enum EstadoOferta {
  PENDIENTE    // el motorista ofreció; el cliente aún no responde
  CONTRAOFERTA // el cliente propuso su propio precio (contraPrecio); espera al motorista
  ACEPTADA
  RECHAZADA    // el cliente dijo que no (o el motorista no aceptó la contraoferta)
  RETIRADA     // el motorista la quitó o tomó otro viaje
}

// Viajes de más km que los incluidos: el motorista propone un precio y el cliente acepta,
// lo rechaza o le contra-ofrece su propio precio (regateo de ida y vuelta, estilo inDrive).
model OfertaPrecio {
  id           String       @id @default(cuid())
  viajeId      String
  viaje        Viaje        @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  motoristaId  String
  motorista    Motorista    @relation(fields: [motoristaId], references: [id])
  precio       Decimal      @db.Decimal(8, 2)
  contraPrecio Decimal?     @db.Decimal(8, 2) // precio que propone el cliente en respuesta a la oferta
  estado       EstadoOferta @default(PENDIENTE)
  creadaEn     DateTime     @default(now())
  respondidaEn DateTime?

  @@index([viajeId, estado])
  @@index([motoristaId, estado])
}

// "No me interesa": ese motorista ya no ve esa solicitud.
model RechazoViaje {
  viajeId     String
  viaje       Viaje     @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  motoristaId String
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  motivo      String    @default("RECHAZO") // RECHAZO o CANCELO (lo soltó después de aceptarlo)
  creadoEn    DateTime  @default(now())

  @@id([viajeId, motoristaId])
}

enum TipoMovimiento {
  RECARGA  // la registra un propietario (ver Recarga)
  COMISION // % de un viaje entregado
  AJUSTE   // corrección manual
}

model MovimientoCredito {
  id            String         @id @default(cuid())
  motoristaId   String
  motorista     Motorista      @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  tipo          TipoMovimiento
  monto         Decimal        @db.Decimal(8, 2) // + suma, - resta
  saldoAntes    Decimal        @db.Decimal(8, 2)
  saldoDespues  Decimal        @db.Decimal(8, 2)
  viajeId       String?
  detalle       String?
  creadoPorId   String?        // propietario, si fue manual
  creadoEn      DateTime       @default(now())
  recargaId     String?
  recarga       Recarga?       @relation(fields: [recargaId], references: [id])

  @@index([motoristaId, creadoEn])
}


// ───────────── Parte 4: recargas de créditos ─────────────

// RECARGA suma al saldo; ACCESO es el pago único para darse de alta (no suma créditos).
enum ConceptoPago {
  RECARGA
  ACCESO
}

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  EN_LINEA // a futuro (Wompi u otro): hoy no se usa
}

// Cada recarga es un recibo (REC-000123). Guarda una copia de los datos del emisor para que el recibo no cambie después.
model Recarga {
  id              String      @id @default(cuid())
  numero          Int         @unique @default(autoincrement())
  motoristaId     String
  motorista       Motorista   @relation(fields: [motoristaId], references: [id])
  concepto        ConceptoPago @default(RECARGA)
  monto           Decimal     @db.Decimal(8, 2)
  formaPago       FormaPago
  referencia      String?     // número de la transferencia
  nota            String?
  saldoAntes      Decimal     @db.Decimal(8, 2)
  deudaDescontada Decimal     @db.Decimal(8, 2) // si estaba en negativo
  saldoDespues    Decimal     @db.Decimal(8, 2)
  registradoPorId String
  registradoPor   Propietario @relation("RecargasRegistradas", fields: [registradoPorId], references: [id])
  creadoEn        DateTime    @default(now())
  emisorNombre    String?
  emisorNit       String?
  emisorDireccion String?
  correoEnviadoA  String?
  correoEnviadoEn DateTime?
  correoError     String?
  anuladaEn       DateTime?
  anuladaPorId    String?
  anuladaPor      Propietario? @relation("RecargasAnuladas", fields: [anuladaPorId], references: [id])
  motivoAnulacion String?
  movimientos     MovimientoCredito[]

  @@index([motoristaId, creadoEn])
  @@index([creadoEn])
  @@index([referencia])
}



// ───────────── Parte 6: clientes ─────────────

// Los clientes no tienen cuenta: se bloquean por su número de celular.
model ClienteBloqueado {
  telefono        String      @id // 8 dígitos
  motivo          String
  bloqueadoPorId  String
  bloqueadoPor    Propietario @relation("ClientesBloqueados", fields: [bloqueadoPorId], references: [id])
  creadoEn        DateTime    @default(now())
}

// Parte 7: gastos de FleteYa (publicidad, carteles, teléfono...) para calcular la ganancia neta en Reportes.
model Gasto {
  id              String      @id @default(cuid())
  fecha           DateTime    @db.Date
  categoria       String      // ver CATEGORIAS_GASTO en src/lib/reportes.ts
  concepto        String
  monto           Decimal     @db.Decimal(10, 2)
  registradoPorId String
  registradoPor   Propietario @relation("GastosRegistrados", fields: [registradoPorId], references: [id])
  creadoEn        DateTime    @default(now())

  @@index([fecha])
}

// Parte 8: avisos al teléfono con la app cerrada (Web Push).
// Es del motorista (para todos sus avisos) o de un viaje (el cliente no tiene cuenta: solo recibe avisos de ese pedido).
model SuscripcionAviso {
  id          String     @id @default(cuid())
  endpoint    String     @unique
  p256dh      String
  auth        String
  motoristaId String?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  viajeId     String?
  viaje       Viaje?     @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  creadaEn    DateTime   @default(now())
  ultimoEnvio DateTime?

  @@index([motoristaId])
  @@index([viajeId])
}
